{
  "authenticationType": "BASIC",
  "filename": "sample-app.deb",
  "options": {
    "username": "demo-user",
    "password": "demo-password"
  },
  "url": "https://example.com/packages/sample-app.deb",
  "retry": {
    "type": "randomWait",
    "policy": {
      "retries": 3,
      "wait": {
        "min": 10,
        "max": 30
      }
    }
  },
  "timeouts": {
    "connection": 5,
    "read": 20
  }
}
