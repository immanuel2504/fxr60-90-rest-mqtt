{
  "endpointConfig": {
    "data": {
      "event": {
        "connections": [
          {
            "name": "DATA_AWS",
            "description": "Tag events to AWS IoT Core",
            "type": "mqtt-AWS",
            "options": {
              "enableSecurity": true,
              "endpoint": {
                "hostName": "a2fvbpwwdngail-ats.iot.eu-north-1.amazonaws.com",
                "port": 8883,
                "protocol": "ssl"
              },
              "additional": {
                "cleanSession": true,
                "clientId": "FXR90-LAB-DATA",
                "debug": false,
                "keepAlive": 20,
                "qos": 0,
                "reconnectDelay": 1,
                "reconnectDelayMax": 30
              },
              "publishTopic": ["datacollection_aws/FXR90-LAB"],
              "subscribeTopic": [],
              "security": {
                "CACertificateFileLocation": "/data/apps/aws/aws-AmazonRootCA1.pem",
                "privateKeyFileLocation": "/data/apps/aws/aws-private.pem.key",
                "publicKeyFileLocation": "/data/apps/aws/aws-certificate.pem.crt",
                "keyAlgorithm": "RS256",
                "keyFormat": "PEM",
                "verifyHostName": true,
                "verifyPeer": true
              }
            },
            "additionalOptions": {
              "batching": {
                "reportingInterval": 1000,
                "maxPayloadSizePerReport": 256000
              },
              "retention": {
                "maxEventRetentionTimeInMin": 500,
                "maxNumEvents": 150000,
                "throttle": 500
              }
            }
          }
        ]
      }
    }
  }
}
