{
  "command": "set_config",
  "command_id": "req-set-config-data-tcpip-server",
  "payload": {
    "READER-GATEWAY": {
      "endpointConfig": {
        "data": {
          "event": {
            "connections": [
              {
                "name": "DATA_TCP_VIA_CONFIG",
                "description": "Tag events over TCP/IP server - reader listens on this port",
                "type": "tcpip-server",
                "options": {
                  "enableSecurity": false,
                  "tcpipport": "8081"
                }
              }
            ]
          }
        }
      },
      "batching": [
        {
          "maxPayloadSizePerReport": 256000,
          "reportingInterval": 2000
        }
      ],
      "retention": [
        {
          "maxEventRetentionTimeInMin": 500,
          "maxNumEvents": 150000,
          "throttle": 500
        }
      ]
    }
  }
}
