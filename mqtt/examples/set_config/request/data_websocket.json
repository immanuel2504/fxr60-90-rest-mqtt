{
  "command": "set_config",
  "command_id": "req-set-config-data-websocket",
  "payload": {
    "READER-GATEWAY": {
      "endpointConfig": {
        "data": {
          "event": {
            "connections": [
              {
                "name": "DATA_WS",
                "description": "Tag events over WebSocket",
                "type": "WEBSOCKET",
                "options": {
                  "security": {
                    "verifyPeer": false
                  }
                },
                "additionalOptions": {
                  "retention": {
                    "maxEventRetentionTimeInMin": 500,
                    "maxNumEvents": 150000,
                    "throttle": 100
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
