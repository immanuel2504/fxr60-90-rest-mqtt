{
  "command": "set_config",
  "command_id": "req-set-config-data-websocket",
  "payload": {
    "READER-GATEWAY": {
      "endpointConfig": {
        "data": {
          "event": {
            "connections": [
              {
                "name": "DATA_WS_VIA_CONFIG",
                "description": "Tag events over WebSocket, set via PUT /cloud/config",
                "type": "WEBSOCKET",
                "options": {
                  "security": {
                    "verifyPeer": false
                  }
                }
              }
            ]
          }
        }
      },
      "batching": [
        {
          "maxPayloadSizePerReport": 256000,
          "reportingInterval": 2000
        }
      ],
      "retention": [
        {
          "maxEventRetentionTimeInMin": 500,
          "maxNumEvents": 150000,
          "throttle": 500
        }
      ]
    }
  }
}
