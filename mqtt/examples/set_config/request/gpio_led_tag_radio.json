        "2": "GREEN",
        "3": "GREEN"
      },
      "TAG_READ": [
        {
          "type": "LED",
          "led": 1,
          "color": "GREEN",
          "postActionColor": "RED",
          "blink": {
            "ON": 100,
            "OFF": 100,
            "DURATION": 500
          }
        }
      ],
      "RADIO_START": [
        {
          "type": "LED",
          "led": 1,
          "color": "AMBER"
        }
      ],
      "RADIO_STOP": [
        {
          "type": "LED",
          "led": 1,
          "color": "RED"
        }
      ]
    }
  }
}
