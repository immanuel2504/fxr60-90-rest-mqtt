{
  "command": "set_config",
  "command_id": "req-set-config-data-aws",
  "payload": {
    "READER-GATEWAY": {
      "endpointConfig": {
        "data": {
          "event": {
            "connections": [
              {
                "name": "DATA_AWS",
                "description": "Tag events to AWS IoT Core",
                "type": "mqtt-AWS",
                "options": {
                  "enableSecurity": true,
                  "endpoint": {
                    "hostName": "test-ats.iot.us-east-1.amazonaws.com",
                    "port": 8883,
                    "protocol": "ssl"
                  },
                  "additional": {
                    "cleanSession": true,
                    "clientId": "FXR90-LAB-DATA",
                    "keepAlive": 20,
                    "qos": 0,
                    "reconnectDelay": 1,
                    "reconnectDelayMax": 30
                  },
                  "publishTopic": [
                    "datacollection_aws/FXR90-LAB"
                  ],
                  "subscribeTopic": [],
                  "security": {
                    "CACertificateFileLocation": "/data/AmazonRootCA1.pem",
                    "privateKeyFileLocation": "/data/aws-pvt.key",
                    "publicKeyFileLocation": "/data/aws-pub.crt",
                    "keyAlgorithm": "RS256",
                    "keyFormat": "PEM",
                    "verifyHostName": true,
                    "verifyPeer": true
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
