{
  "command": "set_config",
  "command_id": "req-set-config-data-aws",
  "payload": {
    "READER-GATEWAY": {
      "endpointConfig": {
        "data": {
          "event": {
            "connections": [
              {
                "name": "DATA_AWS_VIA_CONFIG",
                "description": "Tag events to AWS IoT Core, set via PUT /cloud/config",
                "type": "mqtt-AWS",
                "options": {
                  "enableSecurity": true,
                  "endpoint": {
                    "hostName": "a2fvbpwwdngail-ats.iot.eu-north-1.amazonaws.com",
                    "port": 443,
                    "protocol": "ssl"
                  },
                  "additional": {
                    "cleanSession": true,
                    "clientId": "FXR60-LAB-DATA",
                    "debug": false,
                    "keepAlive": 20,
                    "qos": 0,
                    "reconnectDelay": 1,
                    "reconnectDelayMax": 30,
                    "alpnProtocolNames": [
                      "x-amzn-mqtt-ca"
                    ]
                  },
                  "publishTopic": [
                    "datacollection_aws/FXR60-LAB"
                  ],
                  "subscribeTopic": [],
                  "security": {
                    "CACertificateFileLocation": "/data/apps/AmazonRootCA1.pem",
                    "privateKeyFileLocation": "/data/apps/0e45e82812dfa432797089d8bd85dd813160f82cdc8db8e99893e0e896448666-private.pem.key",
                    "publicKeyFileLocation": "/data/apps/0e45e82812dfa432797089d8bd85dd813160f82cdc8db8e99893e0e896448666-certificate.pem.crt",
                    "keyAlgorithm": "RS256",
                    "keyFormat": "PEM",
                    "verifyHostName": true,
                    "verifyPeer": true
                  }
                }
              }
            ]
          }
        }
      },
      "batching": [
        {
          "maxPayloadSizePerReport": 256000,
          "reportingInterval": 2000
        }
      ],
      "retention": [
        {
          "maxEventRetentionTimeInMin": 500,
          "maxNumEvents": 150000,
          "throttle": 500
        }
      ]
    }
  }
}
