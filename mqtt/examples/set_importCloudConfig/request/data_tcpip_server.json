{
  "command": "set_importCloudConfig",
  "command_id": "req-set-importCloudConfig-data-tcpip-server",
  "payload": {
    "endpointConfig": {
      "data": {
        "event": {
          "connections": [
            {
              "name": "DATA_TCP",
              "description": "Tag events over TCP/IP server",
              "type": "tcpip-server",
              "options": {
                "enableSecurity": false,
                "tcpipport": "8081"
              },
              "additionalOptions": {
                "retention": {
                  "maxEventRetentionTimeInMin": 60,
                  "maxNumEvents": 10000,
                  "throttle": 500
                }
              }
            }
          ]
        }
      }
    }
  }
}
