{
  "method": "PUT",
  "url": "/cloud/cloudConfig",
  "reader": "10.117.229.9 (reader app 5.0.5)",
  "headers": {
    "Authorization": "Bearer <admin JWT>",
    "Content-Type": "application/json",
    "_tokenSource": "Real admin token minted at run time via GET /cloud/localRestLogin with admin:Zebra@123. Not stored - live credential."
  },
  "body": {
    "endpointConfig": {
      "data": {
        "event": {
          "connections": [
            {
              "name": "DATA_TCP",
              "description": "Tag events over TCP/IP server (reader listens on this port)",
              "type": "tcpip-server",
              "options": {
                "enableSecurity": false,
                "tcpipport": "8081"
              },
              "additionalOptions": {
                "retention": {
                  "maxEventRetentionTimeInMin": 500,
                  "maxNumEvents": 150000,
                  "throttle": 500
                }
              }
            }
          ]
        }
      }
    }
  }
}
