{
  "endpointConfig": {
    "control": {
      "commandResponse": {
        "enableLocalRest": true,
        "connections": [
          {
            "name": "CTRL_MQTT_TLS",
            "description": "Control cmd/rsp (MQTT_TLS)",
            "type": "mqtt",
            "options": {
              "enableSecurity": true,
              "endpoint": {
                "hostName": "10.117.229.18",
                "port": 8883,
                "protocol": "ssl"
              },
              "additional": {
                "cleanSession": true,
                "clientId": "fxr60-lab-ctrl",
                "debug": false,
                "keepAlive": 60,
                "qos": 0,
                "reconnectDelay": 2,
                "reconnectDelayMax": 60
              },
              "publishTopic": [
                "fxr60-lab/rsp"
              ],
              "subscribeTopic": [
                "fxr60-lab/cmd"
              ],
              "security": {
                "CACertificateFileLocation": "/data/apps/lab-ca.crt",
                "keyAlgorithm": "RS256",
                "keyFormat": "PEM",
                "verifyHostName": true,
                "verifyPeer": true
              }
            }
          }
        ]
      }
    },
